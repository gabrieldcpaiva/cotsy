---
import '../styles/global.css';
import designSystem from '../../design_system.json';
import AtmosphereChronographIsland from '../components/AtmosphereChronographIsland.astro';
import ChambersLedgerIsland from '../components/ChambersLedgerIsland.astro';
import ResidencyDossierIsland from '../components/ResidencyDossierIsland.astro';

const hearthHotspots = [
  {
    id: 'hearth-flue',
    x: '24%',
    y: '46%',
    code: 'PT.01',
    title: 'Monolithic Slaked-Lime Flue',
    detail: 'Fourteen tons of hand-troweled Gloucestershire lime putty mixed with crushed oolitic aggregate. Retains radiant thermal mass for 18 hours after embers subside.',
  },
  {
    id: 'elm-truss',
    x: '54%',
    y: '14%',
    code: 'PT.02',
    title: '17th-Century Reclaimed Wych Elm',
    detail: 'Salvaged from a dismantled tithe barn in Upper Slaughter, joined purely with seasoned oak draw-bored mortise and tenon pegs—zero structural steel.',
  },
  {
    id: 'flax-daybed',
    x: '60%',
    y: '60%',
    code: 'PT.03',
    title: 'Unbleached Kortrijk Flax Daybed',
    detail: 'Low-slung solid European oak plinth upholstered in 480gsm loom-state Belgian linen stuffed with organic Welsh mountain wool and horsehair.',
  },
];

const harvestMenu = [
  {
    course: 'COURSE 01 // 19:30 GMT',
    dish: 'Broth of Charred Meadow Leek, Wild Wood Sorrel & Cold-Pressed Camelina Oil',
    provenance: 'Walled Kitchen Garden · 120m West of Refectory',
  },
  {
    course: 'COURSE 02 // 20:15 GMT',
    dish: 'Hearth-Roasted Ancient Einkorn Sourdough with Cultured Raw Jersey Butter & Smoked Maldon',
    provenance: 'Stone-Milled Estate Grain · 36-Hour Levain Fermentation',
  },
  {
    course: 'COURSE 03 // 21:00 GMT',
    dish: 'Saddle of Cotswold Fallow Venison Over Bog-Oak Embers, Fermented Blackcurrant & Juniper',
    provenance: 'Windlode North Coppice · Aged 28 Days in Salt Chamber',
  },
  {
    course: 'COURSE 04 // 21:45 GMT',
    dish: 'Warm Raw Heather Comb Honey, Roasted Hazelnut Curd & Meadowsweet Infusion',
    provenance: 'Estate Apiary Hives N° 01–06 · Unfiltered Harvest',
  },
];
---

<!doctype html>
<html lang="en" data-atmosphere="limestone_daylight">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{designSystem.title}</title>
    <meta
      name="description"
      content="COTSY — A seven-chamber monastic countryside inn and architectural sanctuary of hand-troweled lime plaster, weathered silver larch, and subterranean spring water in the Gloucestershire Wold."
    />
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' fill='%23181613'/><circle cx='16' cy='16' r='5' fill='%239E5A3C'/></svg>" />
    <style is:global>
      /* Canonical Substrate Motion & Typographic Laws (Target Artifact: index.astro) */
      :root {
        --canonical-bezier: cubic-bezier(0.16, 1, 0.3, 1);
        --minimum-negative-space: 50%;
        --max-body-monospace-weight: 300;
      }

      *,
      *::before,
      *::after {
        transition-timing-function: cubic-bezier(0.16, 1, 0.3, 1) !important;
      }

      body,
      p,
      span,
      li,
      label,
      input,
      select,
      button,
      dd,
      dt {
        font-family: 'IBM Plex Mono', monospace;
        font-weight: 300;
      }

      .cotsy-parallax-layer {
        will-change: transform;
        transform: translate3d(0, var(--parallax-y, 0px), 0);
        transition: transform 900ms cubic-bezier(0.16, 1, 0.3, 1);
      }
    </style>
  </head>

  <body class="relative min-h-screen bg-canvas-primary text-ink-primary selection:bg-accent-hearth selection:text-canvas-primary">
    <!-- Procedural SVG Lime-Plaster & Unbleached Flax Texture Substrate -->
    <svg class="fixed inset-0 w-full h-full pointer-events-none z-30" style="opacity: var(--grain-opacity); mix-blend-mode: multiply;" aria-hidden="true">
      <filter id="cotsy-substrate-grain">
        <feTurbulence
          type="fractalNoise"
          baseFrequency="0.82"
          numOctaves="4"
          stitchTiles="stitch"
        />
        <feColorMatrix type="saturate" values="0" />
      </filter>
      <rect width="100%" height="100%" filter="url(#cotsy-substrate-grain)" />
    </svg>

    <!-- 12-Column Architectural Datum Hairline Overlay (Toggleable) -->
    <div
      id="architectural-datum-grid"
      class="fixed inset-0 pointer-events-none z-20 px-5 md:px-10 transition-opacity duration-900 ease-cotsy opacity-100"
      aria-hidden="true"
    >
      <div class="w-full h-full grid grid-cols-12">
        {Array.from({ length: 12 }).map((_, idx) => (
          <div class="h-full border-l border-r border-hairline/40 flex flex-col justify-between py-14 px-1">
            <span class="hidden xl:inline-block text-[8px] tracking-[0.24em] font-thin text-ink-muted/40">
              C.{String(idx + 1).padStart(2, '0')}
            </span>
            <span class="hidden xl:inline-block text-[8px] tracking-[0.24em] font-thin text-ink-muted/30">
              {idx < 6 ? 'VOID' : 'MASS'}
            </span>
          </div>
        ))}
      </div>
    </div>

    <!-- Hydration Island 01: Fixed Perimeter Chronograph & Telemetry HUD -->
    <AtmosphereChronographIsland />

    <!-- Main Kinetic Scroll & Multi-Layer Parallax Viewport -->
    <main id="cotsy-scroll-stage" class="relative z-10 w-full pt-20 pb-24">
      <!-- =====================================================================
           SECTION 00: PROLOGUE // THE SILENCE OF OOLITIC STONE
           Spatial Vacancy Mandate: ~65% Uninhabited Limestone Canvas
           ===================================================================== -->
      <section
        id="prologue"
        class="relative w-full min-h-[115vh] px-5 md:px-10 pt-[12vh] pb-[20vh] flex flex-col justify-between"
        data-vacancy-section="prologue"
      >
        <!-- Top Asymmetric Coordinate Row (Col 1-4 occupied, Col 5-12 pure negative space) -->
        <div class="grid grid-cols-12">
          <div class="col-span-12 md:col-span-5 lg:col-span-4 cotsy-reveal is-visible">
            <div class="flex items-center gap-3 mb-2">
              <span class="text-[9px] tracking-[0.26em] uppercase font-thin text-accent-hearth">
                [FOLIO 00 // SPATIAL MANIFEST]
              </span>
              <span class="h-[1px] w-8 bg-accent-hearth/50"></span>
              <span class="text-[9px] tracking-[0.22em] uppercase font-thin text-ink-muted">
                AUTUMN / WINTER 2026
              </span>
            </div>
            <p class="text-[10px] tracking-[0.2em] uppercase font-thin text-ink-muted">
              WINDLODE VALE · GLOUCESTERSHIRE · EST. 1684 / RECONSTRUCTED 2025
            </p>
          </div>
          <!-- Col 5-12: Mandatory Negative Space Void -->
          <div class="hidden md:block md:col-span-7 lg:col-span-8" aria-hidden="true"></div>
        </div>

        <!-- Monumental Editorial Serif Headline (Col 1-9, leaving Col 10-12 & vast vertical bands open) -->
        <div class="my-[10vh] grid grid-cols-12 items-end">
          <div
            class="col-span-12 lg:col-span-9 cotsy-parallax-layer"
            data-parallax-speed="0.06"
          >
            <h1
              class="font-editorial text-ink-primary tracking-monolith"
              style="font-size: clamp(3.4rem, 8.8vw, 9.25rem); line-height: 0.89;"
            >
              An architecture of<br />
              <span class="font-editorial-italic text-ink-secondary">measured stillness,</span><br />
              carved into the mist.
            </h1>
          </div>

          <div class="hidden lg:flex lg:col-span-3 flex-col items-end justify-end pb-4">
            <div class="hairline-l pl-4 py-1">
              <span class="block text-[8px] tracking-[0.26em] uppercase font-thin text-ink-muted">
                SPATIAL VACANCY PERIMETER
              </span>
              <span class="block text-[10px] tracking-[0.2em] uppercase font-light text-ink-primary mt-1">
                ≥ 50.0% NEGATIVE CANVAS
              </span>
            </div>
          </div>
        </div>

        <!-- Asymmetric Lower Split: Col 1-4 Sparse 300-Weight Monospace Thesis | Col 5-6 Void | Col 7-12 Hero Plate -->
        <div class="grid grid-cols-12 gap-y-12 items-end pt-[4vh]">
          <!-- Col 1-4: 300-Weight Utility Monospace Body Prose -->
          <div
            class="col-span-12 lg:col-span-4 cotsy-parallax-layer flex flex-col gap-6"
            data-parallax-speed="0.11"
          >
            <div class="hairline-t pt-5">
              <span class="block text-[9px] tracking-[0.24em] uppercase font-thin text-ink-muted mb-3">
                00.1 // ARCHITECTURAL ABSTRACT
              </span>
              <p class="text-[13px] font-light text-ink-secondary leading-[1.92] max-w-[40ch]">
                Set within forty-two acres of unploughed Gloucestershire limestone meadow, Cotsy is neither hotel nor country club. It is a seven-chamber monastic sanctuary of hand-troweled lime plaster, weathered silver larch, and subterranean spring water—engineered for unhurried contemplation.
              </p>
            </div>

            <div class="grid grid-cols-2 gap-4 pt-3 hairline-t text-[9px] tracking-[0.2em] uppercase font-thin text-ink-muted">
              <div>
                <span class="block text-ink-primary font-light">42.0 ACRES</span>
                <span>UNPLOUGHED WOLD</span>
              </div>
              <div>
                <span class="block text-ink-primary font-light">18.4 dBA</span>
                <span>AMBIENT NOISE FLOOR</span>
              </div>
            </div>

            <div class="pt-2 flex items-center gap-4">
              <a
                href="#chambers"
                class="px-4 py-2.5 hairline-box bg-ink-primary text-canvas-primary text-[9px] tracking-[0.24em] uppercase font-light hover:bg-accent-hearth transition-colors duration-700 ease-cotsy"
              >
                [EXPLORE THE SEVEN CHAMBERS ↓]
              </a>
              <a
                href="#residency-dossier"
                class="text-[9px] tracking-[0.22em] uppercase font-light text-ink-secondary hover:text-ink-primary transition-colors duration-450 ease-cotsy"
              >
                INQUIre DOSSIER →
              </a>
            </div>
          </div>

          <!-- Col 5-6: Uninhabited Limestone Canvas Void -->
          <div class="hidden lg:block lg:col-span-2" aria-hidden="true"></div>

          <!-- Col 7-12: Primary Architectural Plate with Multi-Layer Y-Axis Parallax -->
          <div
            class="col-span-12 lg:col-span-6 cotsy-parallax-layer"
            data-parallax-speed="-0.14"
          >
            <figure class="hairline-box p-3 md:p-4 bg-canvas-elevated/60">
              <div class="flex items-center justify-between mb-2.5 text-[9px] tracking-[0.22em] uppercase font-thin text-ink-muted">
                <span>PLATE 01 // SOUTH COURTYARD & RAINWATER MIRROR BASIN</span>
                <span>06:14 GMT · 4×5 ARCA-SWISS</span>
              </div>
              <div
                class="cotsy-image-curtain is-revealed aspect-[16/10] w-full overflow-hidden"
                data-image-parallax="0.16"
              >
                <img
                  src="/images/hero-sanctuary.jpg"
                  alt="Minimalist Cotswold limestone and weathered silver larch countryside inn reflected in a still rainwater courtyard pool at dawn"
                  class="w-full h-full object-cover"
                />
              </div>
              <figcaption class="mt-3 flex flex-wrap items-center justify-between gap-2 text-[9px] tracking-[0.2em] uppercase font-thin text-ink-muted">
                <span>OOLITIC ASHLAR CANTILEVER OVER BLACK BASALT CATCHMENT</span>
                <span class="text-accent-hearth font-light">HUMIDITY 88% · HEARTH 21.5°C</span>
              </figcaption>
            </figure>
          </div>
        </div>
      </section>

      <!-- =====================================================================
           SECTION 01: LITHIC THESIS // ASYMMETRIC DIALOGUE OF MASS & VOID
           Spatial Vacancy Mandate: ~68% Uninhabited Canvas
           ===================================================================== -->
      <section
        id="lithic-thesis"
        class="relative w-full px-5 md:px-10 py-[24vh] hairline-t"
        data-vacancy-section="lithic-thesis"
      >
        <div class="grid grid-cols-12 gap-y-16 items-start">
          <!-- Col 1-4: Sticky / Parallax Architectural Thesis & Axioms -->
          <div
            class="col-span-12 lg:col-span-4 cotsy-parallax-layer flex flex-col gap-8"
            data-parallax-speed="0.09"
          >
            <div>
              <span class="text-[9px] tracking-[0.26em] uppercase font-thin text-ink-muted block mb-4">
                [01 // THE LITHIC THESIS]
              </span>
              <h2
                class="font-editorial text-ink-primary"
                style="font-size: clamp(2.25rem, 4.4vw, 4.5rem); line-height: 0.94; letter-spacing: -0.028em;"
              >
                Cozy modernism is not the accumulation of ornament; it is the
                <span class="font-editorial-italic text-ink-secondary">warmth of raw matter</span>
                held in vast quietude.
              </h2>
            </div>

            <p class="text-[13px] font-light text-ink-secondary leading-[1.92] max-w-[42ch]">
              Where conventional country house hotels fill every corner with chintz and gilded distraction, Cotsy removes fifty-eight percent of interior partitions. Light travels unimpeded across honed travertine slabs, grazing hand-troweled slaked lime walls that breathe with the barometric pressure of the valley.
            </p>

            <!-- Three Architectural Axioms (Max 300 Weight Monospace) -->
            <div class="flex flex-col hairline-t">
              <div class="py-4 hairline-b flex flex-col gap-1">
                <div class="flex items-center justify-between text-[9px] tracking-[0.22em] uppercase font-thin text-accent-hearth">
                  <span>AXIOM 01.1</span>
                  <span>NRC 0.74 ABSORPTION</span>
                </div>
                <p class="text-[11px] font-light text-ink-primary">
                  Porous lime-hemp plaster and unbleached Belgian flax absorb high-frequency chatter while preserving the low crackle of seasoned oak.
                </p>
              </div>

              <div class="py-4 hairline-b flex flex-col gap-1">
                <div class="flex items-center justify-between text-[9px] tracking-[0.22em] uppercase font-thin text-accent-hearth">
                  <span>AXIOM 01.2</span>
                  <span>RADIANT HYDRONIC FLOOR</span>
                </div>
                <p class="text-[11px] font-light text-ink-primary">
                  Geothermal borehole loops beneath 90mm flagstone slabs maintain an imperceptible 21.5°C barefoot datum across every threshold.
                </p>
              </div>

              <div class="py-4 hairline-b flex flex-col gap-1">
                <div class="flex items-center justify-between text-[9px] tracking-[0.22em] uppercase font-thin text-accent-hearth">
                  <span>AXIOM 01.3</span>
                  <span>ZERO ARTIFICIAL GLARE</span>
                </div>
                <p class="text-[11px] font-light text-ink-primary">
                  After sundown, illumination is restricted to 2200K recessed limestone grazing slots, open hearths, and hand-dipped beeswax tapers.
                </p>
              </div>
            </div>
          </div>

          <!-- Col 5-6: Mandatory Uninhabited Negative Space Void Bay -->
          <div class="hidden lg:block lg:col-span-2" aria-hidden="true"></div>

          <!-- Col 7-12: Interactive Hearth Pavilion Plate + Offset Secondary Cloister Plate -->
          <div class="col-span-12 lg:col-span-6 flex flex-col gap-[18vh]">
            <!-- Primary Plate: The Great Lime-Plaster Hearth (with Interactive Provenance Pins) -->
            <div
              class="cotsy-parallax-layer"
              data-parallax-speed="-0.15"
            >
              <div class="hairline-box p-3 md:p-5 bg-canvas-elevated/60">
                <div class="flex items-center justify-between mb-3 text-[9px] tracking-[0.22em] uppercase font-thin text-ink-muted">
                  <span>PLATE 02 // THE GREAT LIME-PLASTER HEARTH & FLAX DAYBED</span>
                  <span>CLICK PINS [PT.01–03]</span>
                </div>

                <div
                  class="cotsy-image-curtain is-revealed relative aspect-[16/10] w-full overflow-hidden"
                  data-image-parallax="0.14"
                >
                  <img
                    src="/images/hearth-pavilion.jpg"
                    alt="Interior of the Great Hearth Pavilion with monolithic lime plaster fireplace and Belgian linen daybed"
                    class="w-full h-full object-cover"
                  />

                  {hearthHotspots.map((spot, idx) => (
                    <button
                      type="button"
                      data-hotspot-btn={spot.id}
                      data-hotspot-title={spot.title}
                      data-hotspot-detail={spot.detail}
                      data-hotspot-code={spot.code}
                      style={`left: ${spot.x}; top: ${spot.y};`}
                      class:list={[
                        'hearth-hotspot absolute -translate-x-1/2 -translate-y-1/2 z-10 px-2 py-1 text-[8px] tracking-[0.2em] uppercase font-light transition-all duration-700 ease-cotsy',
                        idx === 0
                          ? 'bg-accent-hearth text-canvas-primary scale-105'
                          : 'bg-canvas-primary/90 text-ink-primary hairline-box hover:bg-ink-primary hover:text-canvas-primary',
                      ]}
                    >
                      {spot.code}
                    </button>
                  ))}
                </div>

                <!-- Interactive Hotspot Readout Strip -->
                <div class="mt-4 p-4 hairline-box bg-canvas-secondary/40 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                  <div>
                    <div class="flex items-center gap-2">
                      <span id="hotspot-active-code" class="text-[9px] tracking-[0.24em] uppercase font-light text-accent-hearth">
                        PT.01
                      </span>
                      <span id="hotspot-active-title" class="font-editorial text-xl text-ink-primary">
                        Monolithic Slaked-Lime Flue
                      </span>
                    </div>
                    <p id="hotspot-active-detail" class="text-[11px] font-light text-ink-secondary mt-1 leading-relaxed">
                      Fourteen tons of hand-troweled Gloucestershire lime putty mixed with crushed oolitic aggregate. Retains radiant thermal mass for 18 hours after embers subside.
                    </p>
                  </div>
                </div>
              </div>
            </div>

            <!-- Asymmetric Offset Sub-Plate: Shifted to Col 1-9 of this 6-col container -->
            <div
              class="w-full md:w-4/5 cotsy-parallax-layer"
              data-parallax-speed="-0.21"
            >
              <figure class="hairline-box p-3 bg-canvas-elevated/50">
                <div class="flex items-center justify-between mb-2 text-[9px] tracking-[0.22em] uppercase font-thin text-ink-muted">
                  <span>PLATE 03 // WEST TIMBER LOGGIA AT CREPUSCULAR HOUR</span>
                  <span>17:48 GMT</span>
                </div>
                <div
                  class="cotsy-image-curtain is-revealed aspect-[16/10] w-full overflow-hidden"
                  data-image-parallax="0.12"
                >
                  <img
                    src="/images/meadow-cloister.jpg"
                    alt="Covered limestone and timber colonnade looking out over misty Cotswold hills at dusk"
                    class="w-full h-full object-cover"
                  />
                </div>
                <figcaption class="mt-2.5 text-[10px] font-light text-ink-secondary leading-relaxed">
                  Dry-coursed Guiting limestone walling meets an unglazed European larch colonnade, framing forty-two acres of valley mist.
                </figcaption>
              </figure>
            </div>
          </div>
        </div>
      </section>

      <!-- =====================================================================
           SECTION 02: THE SEVEN CHAMBERS // ARCHITECTURAL RESIDENCY LEDGER
           Hydration Island 02
           ===================================================================== -->
      <ChambersLedgerIsland />

      <!-- =====================================================================
           SECTION 03: MATERIAL SUBSTRATE & SECTION 05: RESIDENCY DOSSIER
           Wait: Let's place Section 04 (Subterranean Thermal & Foraging Refectory)
           in sequence between Material Substrate and Residency Dossier, or let's
           render Section 04 right after Chambers and before Material/Residency!
           ===================================================================== -->
      <section
        id="thermal-refectory"
        class="relative w-full px-5 md:px-10 py-[24vh] hairline-t"
        data-vacancy-section="thermal-refectory"
      >
        <!-- Upper Asymmetric Diptych: Subterranean Thermal Bathhouse -->
        <div class="grid grid-cols-12 gap-y-14 items-start">
          <!-- Col 1-6: Subterranean Basalt Vessel Plate -->
          <div
            class="col-span-12 lg:col-span-6 cotsy-parallax-layer"
            data-parallax-speed="-0.15"
          >
            <figure class="hairline-box p-3 md:p-5 bg-canvas-elevated/60">
              <div class="flex items-center justify-between mb-3 text-[9px] tracking-[0.22em] uppercase font-thin text-ink-muted">
                <span>[04.A // SUBTERRANEAN THERMAL BATHHOUSE]</span>
                <span>DEPTH -4.8M BELOW COURTYARD</span>
              </div>
              <div
                class="cotsy-image-curtain is-revealed aspect-[16/10] w-full overflow-hidden"
                data-image-parallax="0.15"
              >
                <img
                  src="/images/bathhouse-thermal.jpg"
                  alt="Subterranean stone bathhouse with carved black basalt soaking vessel and zenithal skylight"
                  class="w-full h-full object-cover"
                />
              </div>
              <figcaption class="mt-3 flex items-center justify-between text-[9px] tracking-[0.2em] uppercase font-thin text-ink-muted">
                <span>CARVED HONED BASALT MONOLITH · ZENITHAL OCULUS</span>
                <span class="text-accent-hearth font-light">WATER TEMP 39.2°C CONSTANT</span>
              </figcaption>
            </figure>
          </div>

          <!-- Col 7-8: Mandatory Uninhabited Negative Space Void -->
          <div class="hidden lg:block lg:col-span-2" aria-hidden="true"></div>

          <!-- Col 9-12: Hydro-Mineral Telemetry & Editorial Prose (Vertically Offset +14vh) -->
          <div
            class="col-span-12 lg:col-span-4 lg:mt-[14vh] cotsy-parallax-layer flex flex-col gap-6"
            data-parallax-speed="0.10"
          >
            <span class="text-[9px] tracking-[0.26em] uppercase font-thin text-accent-hearth">
              ARTESIAN AQUIFER // ZERO CHLORINATION
            </span>
            <h2
              class="font-editorial text-ink-primary"
              style="font-size: clamp(2.2rem, 4.2vw, 4.2rem); line-height: 0.94; letter-spacing: -0.025em;"
            >
              Water drawn from three hundred feet beneath the wold,
              <span class="font-editorial-italic text-ink-secondary">heated by fallen timber.</span>
            </h2>
            <p class="text-[13px] font-light text-ink-secondary leading-[1.92]">
              Excavated directly into the Inferior Oolite bedrock, the bathhouse is reserved for one chamber at a time by brass hourglass. A narrow zenithal oculus admits a single blade of sky light that tracks across the steaming basalt vessel from dawn until noon.
            </p>

            <!-- Hydro-Mineral Assay Table (300-weight monospace) -->
            <div class="p-4 hairline-box bg-canvas-secondary/35">
              <span class="block text-[8px] tracking-[0.24em] uppercase font-thin text-ink-muted mb-3">
                HYDRO-MINERAL ASSAY // SPRING BOREHOLE N° 02
              </span>
              <div class="grid grid-cols-2 gap-y-2 text-[10px] font-light">
                <span class="text-ink-muted">CALCIUM (Ca²⁺)</span>
                <span class="text-right text-ink-primary">114.2 mg/L</span>
                <span class="text-ink-muted">MAGNESIUM (Mg²⁺)</span>
                <span class="text-right text-ink-primary">28.6 mg/L</span>
                <span class="text-ink-muted">BICARBONATE (HCO₃⁻)</span>
                <span class="text-right text-ink-primary">310.0 mg/L</span>
                <span class="text-ink-muted">NATURAL PH DATUM</span>
                <span class="text-right text-ink-primary">7.48 pH</span>
              </div>
            </div>
          </div>
        </div>

        <!-- 24vh Vertical Breathing Void Between Thermal & Refectory -->
        <div class="h-[22vh] w-full flex items-center justify-center" aria-hidden="true">
          <span class="text-[8px] tracking-[0.3em] uppercase font-thin text-ink-muted/40">
            [VERTICAL VACANCY CADENCE // +22VH]
          </span>
        </div>

