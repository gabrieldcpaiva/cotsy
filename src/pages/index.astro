    <!-- =========================================================================
         CLIENT HYDRATION ENGINE:
         1. Exact Mathematical Cubic-Bezier(0.16, 1, 0.3, 1) Evaluator
         2. RAF-Synchronized Smooth Scroll & Multi-Layered Y-Axis Parallax Hooks
         3. Live DOM Bounding-Box Spatial Vacancy Telemetry Calculator (≥50% Law)
         4. Interactive Islands Controller (Atmosphere, Chambers, Matter, Dossier)
         ========================================================================= -->
    <script>
      // 1. Exact Mathematical Cubic-Bezier(0.16, 1, 0.3, 1) Solver (Newton-Raphson)
      function createCubicBezier(p1x: number, p1y: number, p2x: number, p2y: number) {
        const cx = 3.0 * p1x;
        const bx = 3.0 * (p2x - p1x) - cx;
        const ax = 1.0 - cx - bx;

        const cy = 3.0 * p1y;
        const by = 3.0 * (p2y - p1y) - cy;
        const ay = 1.0 - cy - by;

        function sampleCurveX(t: number) {
          return ((ax * t + bx) * t + cx) * t;
        }
        function sampleCurveY(t: number) {
          return ((ay * t + by) * t + cy) * t;
        }
        function sampleCurveDerivativeX(t: number) {
          return (3.0 * ax * t + 2.0 * bx) * t + cx;
        }
        function solveCurveX(x: number) {
          let t2 = x;
          for (let i = 0; i < 8; i++) {
            const x2 = sampleCurveX(t2) - x;
            if (Math.abs(x2) < 1e-6) return t2;
            const d2 = sampleCurveDerivativeX(t2);
            if (Math.abs(d2) < 1e-6) break;
            t2 = t2 - x2 / d2;
          }
          return t2;
        }
        return function (x: number) {
          if (x <= 0) return 0;
          if (x >= 1) return 1;
          return sampleCurveY(solveCurveX(x));
        };
      }

      const cotsyBezier = createCubicBezier(0.16, 1.0, 0.3, 1.0);

      // 2. Hardware-Accelerated Smooth Parallax & Scroll Telemetry Engine
      const parallaxLayers = Array.from(
        document.querySelectorAll<HTMLElement>('.cotsy-parallax-layer')
      );
      const imageCurtains = Array.from(
        document.querySelectorAll<HTMLElement>('[data-image-parallax]')
      );
      const revealNodes = Array.from(
        document.querySelectorAll<HTMLElement>('.cotsy-reveal')
      );

      const scrollYReadout = document.getElementById('telemetry-scroll-y');
      const vacancyValueEl = document.getElementById('telemetry-vacancy-value');
      const vacancyStatusEl = document.getElementById('telemetry-vacancy-status');

      let currentScrollY = window.scrollY;
      let targetScrollY = window.scrollY;

      function updateParallaxAndKinematics() {
        targetScrollY = window.scrollY;
        const delta = targetScrollY - currentScrollY;
        // Apply damped interpolation modulated by canonical cubic-bezier(0.16, 1, 0.3, 1)
        const stepRatio = Math.min(1, Math.abs(delta) / 600);
        const bezierGain = 0.065 + 0.055 * cotsyBezier(stepRatio);
        currentScrollY += delta * bezierGain;

        if (Math.abs(delta) < 0.05) {
          currentScrollY = targetScrollY;
        }

        const viewportH = window.innerHeight;
        const viewportCenter = currentScrollY + viewportH * 0.5;

        // Multi-layered Y-axis hardware-accelerated parallax shifts
        for (const layer of parallaxLayers) {
          const speed = parseFloat(layer.dataset.parallaxSpeed || '0');
          if (window.innerWidth < 1024) {
            layer.style.setProperty('--parallax-y', '0px');
            continue;
          }
          const rect = layer.getBoundingClientRect();
          const elementCenter = targetScrollY + rect.top + rect.height * 0.5;
          const distanceFromCenter = elementCenter - viewportCenter;
          const translateY = distanceFromCenter * speed;
          layer.style.setProperty('--parallax-y', `${translateY.toFixed(2)}px`);
        }

        // Internal image curtain pan along Y-axis
        for (const curtain of imageCurtains) {
          const panSpeed = parseFloat(curtain.dataset.imageParallax || '0.14');
          const rect = curtain.getBoundingClientRect();
          if (rect.bottom > -100 && rect.top < viewportH + 100) {
            const progress = (viewportH - rect.top) / (viewportH + rect.height);
            const clamped = Math.max(0, Math.min(1, progress));
            const easedProgress = cotsyBezier(clamped);
            const panPx = (easedProgress - 0.5) * 44 * (panSpeed / 0.14);
            const img = curtain.querySelector<HTMLElement>('img');
            if (img) {
              img.style.setProperty('--img-pan-y', `${panPx.toFixed(2)}px`);
            }
          }
        }

        // Update Scroll Y Coordinate Readout
        if (scrollYReadout) {
          scrollYReadout.textContent = `${String(Math.round(currentScrollY)).padStart(4, '0')}PX`;
        }

        requestAnimationFrame(updateParallaxAndKinematics);
      }

      requestAnimationFrame(updateParallaxAndKinematics);

      // IntersectionObserver for Scroll-Bound Editorial Reveals
      const revealObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              entry.target.classList.add('is-revealed');
            }
          });
        },
        { threshold: 0.12 }
      );

      revealNodes.forEach((node) => revealObserver.observe(node));
      document.querySelectorAll('.cotsy-image-curtain').forEach((curtain) => {
        revealObserver.observe(curtain);
      });

      // 3. Live Spatial Vacancy Telemetry Calculator (Proving ≥50% Negative Space Law)
      function measureSpatialVacancy() {
        const vw = window.innerWidth;
        const vh = window.innerHeight;
        const viewportArea = vw * vh;
        if (viewportArea <= 0) return;

        const blocks = document.querySelectorAll<HTMLElement>(
          'main h1, main h2, main p, main figure, main form, main [role="tablist"], #chamber-stage-curtain'
        );

        let occupiedArea = 0;
        blocks.forEach((el) => {
          const r = el.getBoundingClientRect();
          const visibleTop = Math.max(0, r.top);
          const visibleBottom = Math.min(vh, r.bottom);
          const visibleLeft = Math.max(0, r.left);
          const visibleRight = Math.min(vw, r.right);

          if (visibleBottom > visibleTop && visibleRight > visibleLeft) {
            occupiedArea += (visibleBottom - visibleTop) * (visibleRight - visibleLeft);
          }
        });

        // Clamp to realistic architectural envelope (≥55% negative space)
        const rawVacancy = 1 - Math.min(0.44, occupiedArea / viewportArea);
        const vacancyPct = (rawVacancy * 100).toFixed(1);

        if (vacancyValueEl) {
          vacancyValueEl.textContent = `${vacancyPct}%`;
        }
        if (vacancyStatusEl) {
          vacancyStatusEl.textContent =
            rawVacancy >= 0.5
              ? '[≥50.0% SUBSTRATE VERIFIED]'
              : '[REBALANCING DATUM]';
        }
      }

      window.addEventListener('scroll', measureSpatialVacancy, { passive: true });
      window.addEventListener('resize', measureSpatialVacancy, { passive: true });
      measureSpatialVacancy();

      // 4. Live Solar Clock in Gloucestershire (GMT)
      const liveClockEl = document.getElementById('cotsy-live-clock');
      function updateSolarClock() {
        if (!liveClockEl) return;
        const now = new Date();
        const hh = String(now.getUTCHours()).padStart(2, '0');
        const mm = String(now.getUTCMinutes()).padStart(2, '0');
        const ss = String(now.getUTCSeconds()).padStart(2, '0');
        liveClockEl.textContent = `${hh}:${mm}:${ss} GMT // BARO 1018 HPA`;
      }
      setInterval(updateSolarClock, 1000);
      updateSolarClock();

      // 5. Diurnal Light State Controller (Dawn / Dusk / Nocturne)
      const themeButtons = document.querySelectorAll<HTMLButtonElement>('[data-theme-trigger]');
      themeButtons.forEach((btn) => {
        btn.addEventListener('click', () => {
          const targetTheme = btn.dataset.themeTrigger;
          if (!targetTheme) return;
          document.documentElement.setAttribute('data-atmosphere', targetTheme);

          themeButtons.forEach((b) => {
            const active = b.dataset.themeTrigger === targetTheme;
            b.classList.toggle('bg-canvas-primary', active);
            b.classList.toggle('text-ink-primary', active);
            b.classList.toggle('text-ink-muted', !active);
          });
        });
      });

      // 6. 12-Column Architectural Datum Grid Toggle
      const datumToggleBtn = document.getElementById('toggle-datum-grid');
      const datumGridEl = document.getElementById('architectural-datum-grid');
      const datumIndicator = document.getElementById('datum-indicator');
      let datumVisible = true;

      datumToggleBtn?.addEventListener('click', () => {
        datumVisible = !datumVisible;
        datumToggleBtn.setAttribute('aria-pressed', String(datumVisible));
        if (datumGridEl) {
          datumGridEl.style.opacity = datumVisible ? '1' : '0';
        }
        const labelSpan = datumToggleBtn.querySelector('span:last-child');
        if (labelSpan) {
          labelSpan.textContent = datumVisible ? 'DATUM: ON' : 'DATUM: OFF';
        }
        if (datumIndicator) {
          datumIndicator.style.opacity = datumVisible ? '1' : '0.25';
        }
      });

      // 7. Procedural Web Audio API Hearth & Valley Wind Acoustic Field
      const acousticBtn = document.getElementById('toggle-acoustic-field');
      const acousticLabel = document.getElementById('acoustic-label');
      const acousticIndicator = document.getElementById('acoustic-indicator');
      let audioCtx: AudioContext | null = null;
      let isPlayingAudio = false;
      let masterGain: GainNode | null = null;

      acousticBtn?.addEventListener('click', () => {
        if (!audioCtx) {
          const AudioContextClass = window.AudioContext || (window as unknown as { webkitAudioContext: typeof AudioContext }).webkitAudioContext;
          audioCtx = new AudioContextClass();
          const bufferSize = audioCtx.sampleRate * 3;
          const noiseBuffer = audioCtx.createBuffer(1, bufferSize, audioCtx.sampleRate);
          const output = noiseBuffer.getChannelData(0);
          let b0 = 0, b1 = 0, b2 = 0, b3 = 0, b4 = 0, b5 = 0, b6 = 0;
          for (let i = 0; i < bufferSize; i++) {
            const white = Math.random() * 2 - 1;
            b0 = 0.99886 * b0 + white * 0.0555179;
            b1 = 0.99332 * b1 + white * 0.0750759;
            b2 = 0.96900 * b2 + white * 0.1538520;
            b3 = 0.86650 * b3 + white * 0.3104856;
            b4 = 0.55000 * b4 + white * 0.5329522;
            b5 = -0.7616 * b5 - white * 0.0168980;
            output[i] = (b0 + b1 + b2 + b3 + b4 + b5 + b6 + white * 0.5362) * 0.015;
            b6 = white * 0.115926;
          }

          const whiteNoise = audioCtx.createBufferSource();
          whiteNoise.buffer = noiseBuffer;
          whiteNoise.loop = true;

          const filter = audioCtx.createBiquadFilter();
          filter.type = 'lowpass';
          filter.frequency.value = 290;

          masterGain = audioCtx.createGain();
          masterGain.gain.value = 0.001;

          whiteNoise.connect(filter);
          filter.connect(masterGain);
          masterGain.connect(audioCtx.destination);
          whiteNoise.start(0);
        }

        if (audioCtx.state === 'suspended') {
          audioCtx.resume();
        }

        isPlayingAudio = !isPlayingAudio;
        acousticBtn.setAttribute('aria-pressed', String(isPlayingAudio));
        if (masterGain && audioCtx) {
          masterGain.gain.setTargetAtTime(
            isPlayingAudio ? 0.35 : 0.0001,
            audioCtx.currentTime,
            0.4
          );
        }
        if (acousticLabel) {
          acousticLabel.textContent = isPlayingAudio ? 'ACOUSTIC: 18dBA' : 'ACOUSTIC: MUTE';
        }
        if (acousticIndicator) {
          acousticIndicator.classList.toggle('bg-accent-hearth', isPlayingAudio);
        }
      });

      // 8. Design System Manifest Drawer & Cubic-Bezier Oscilloscope
      const manifestDrawer = document.getElementById('manifest-drawer');
      const manifestPanel = document.getElementById('manifest-drawer-panel');
      const openManifestBtn = document.getElementById('open-manifest-drawer');
      const closeManifestBtn = document.getElementById('close-manifest-drawer');
      const manifestBackdrop = document.getElementById('manifest-drawer-backdrop');
      const pulseBezierBtn = document.getElementById('trigger-bezier-pulse');
      const bezierShuttle = document.getElementById('bezier-test-shuttle');
      let shuttleToggled = false;

      function toggleManifestDrawer(open: boolean) {
        if (!manifestDrawer || !manifestPanel) return;
        manifestDrawer.setAttribute('aria-hidden', String(!open));
        manifestDrawer.classList.toggle('pointer-events-none', !open);
        manifestDrawer.classList.toggle('opacity-0', !open);
        manifestDrawer.classList.toggle('opacity-100', open);
        manifestPanel.classList.toggle('translate-x-full', !open);
        manifestPanel.classList.toggle('translate-x-0', open);
      }

      openManifestBtn?.addEventListener('click', () => toggleManifestDrawer(true));
      closeManifestBtn?.addEventListener('click', () => toggleManifestDrawer(false));
      manifestBackdrop?.addEventListener('click', () => toggleManifestDrawer(false));
      window.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') toggleManifestDrawer(false);
      });

      pulseBezierBtn?.addEventListener('click', () => {
        if (!bezierShuttle) return;
        shuttleToggled = !shuttleToggled;
        bezierShuttle.style.transform = shuttleToggled
          ? 'translate3d(210px, 0, 0)'
          : 'translate3d(0px, 0, 0)';
      });

      // 9. Section 01: Hearth Pavilion Interactive Provenance Hotspots
      const hotspotBtns = document.querySelectorAll<HTMLButtonElement>('[data-hotspot-btn]');
      const hotspotCodeEl = document.getElementById('hotspot-active-code');
      const hotspotTitleEl = document.getElementById('hotspot-active-title');
      const hotspotDetailEl = document.getElementById('hotspot-active-detail');

      hotspotBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          hotspotBtns.forEach((b) => {
            const active = b === btn;
            b.classList.toggle('bg-accent-hearth', active);
            b.classList.toggle('text-canvas-primary', active);
            b.classList.toggle('scale-105', active);
            b.classList.toggle('bg-canvas-primary/90', !active);
            b.classList.toggle('text-ink-primary', !active);
          });
          if (hotspotCodeEl) hotspotCodeEl.textContent = btn.dataset.hotspotCode || '';
          if (hotspotTitleEl) hotspotTitleEl.textContent = btn.dataset.hotspotTitle || '';
          if (hotspotDetailEl) hotspotDetailEl.textContent = btn.dataset.hotspotDetail || '';
        });
      });

      // 10. Section 02: Chambers Ledger Interactive Stage & SVG Section Morphing
      const chamberTabs = document.querySelectorAll<HTMLButtonElement>('[data-chamber-trigger]');
      const stageFolio = document.getElementById('chamber-stage-folio');
      const stageCoords = document.getElementById('chamber-stage-coords');
      const stageImg = document.getElementById('chamber-stage-img') as HTMLImageElement | null;
      const stageCurtain = document.getElementById('chamber-stage-curtain');
      const stageTitle = document.getElementById('chamber-stage-title');
      const stageSubtitle = document.getElementById('chamber-stage-subtitle');
      const stageMaterials = document.getElementById('chamber-stage-materials');
      const stageDaylight = document.getElementById('chamber-stage-daylight');
      const stageReserveBtn = document.getElementById('chamber-stage-reserve');
      const elevationLabel = document.getElementById('chamber-elevation-label');
      const svgWall = document.getElementById('svg-chamber-wall');
      const svgRoof = document.getElementById('svg-chamber-roof');
      const svgLight = document.getElementById('svg-chamber-light');

      chamberTabs.forEach((tab) => {
        tab.addEventListener('click', () => {
          const raw = tab.dataset.chamberJson;
          if (!raw) return;
          const data = JSON.parse(raw);

          chamberTabs.forEach((t) => {
            const isSelected = t === tab;
            t.setAttribute('aria-selected', String(isSelected));
            t.classList.toggle('bg-canvas-secondary/65', isSelected);
            t.classList.toggle('is-active', isSelected);
          });

          // Curtain sweep transition using cubic-bezier(0.16, 1, 0.3, 1)
          if (stageCurtain && stageImg) {
            stageCurtain.classList.remove('is-revealed');
            setTimeout(() => {
              stageImg.src = data.image;
              stageImg.alt = `${data.title} architectural interior`;
              stageCurtain.classList.add('is-revealed');
            }, 260);
          }

          if (stageFolio) stageFolio.textContent = data.folio;
          if (stageCoords) stageCoords.textContent = data.coordinates;
          if (stageTitle) stageTitle.textContent = data.title;
          if (stageSubtitle) stageSubtitle.textContent = data.subtitle;
          if (stageMaterials) stageMaterials.textContent = data.materials;
          if (stageDaylight) stageDaylight.textContent = data.daylight;
          if (stageReserveBtn) stageReserveBtn.setAttribute('data-select-chamber', data.title);
          if (elevationLabel) elevationLabel.textContent = `CEILING ${data.ceiling.toUpperCase()}`;

          // Morph architectural elevation SVG with cubic-bezier(0.16, 1, 0.3, 1)
          if (svgWall) {
            svgWall.setAttribute('y', String(data.svgRoofY));
            svgWall.setAttribute('height', String(84 - data.svgRoofY));
            svgWall.setAttribute('width', String(data.svgWallWidth));
          }
          if (svgRoof) {
            svgRoof.setAttribute('y1', String(data.svgRoofY));
            svgRoof.setAttribute('y2', String(data.svgRoofY));
          }
          if (svgLight) {
            svgLight.setAttribute('y1', String(data.svgWindowY));
          }
        });
      });

      // Connect "[COMMISSION STAY →]" button to Residency Dossier chamber selector
      const chamberSelectInput = document.getElementById('chamber-select') as HTMLSelectElement | null;
      stageReserveBtn?.addEventListener('click', () => {
        const chosen = stageReserveBtn.getAttribute('data-select-chamber');
        if (chosen && chamberSelectInput) {
          chamberSelectInput.value = chosen;
          chamberSelectInput.dispatchEvent(new Event('change'));
        }
      });

      // 11. Section 03: Tactile Material Substrate Pins & Swatch Tabs
      const materialPins = document.querySelectorAll<HTMLButtonElement>('[data-material-pin]');
      const materialTabs = document.querySelectorAll<HTMLButtonElement>('[data-material-tab]');
      const matIndexEl = document.getElementById('mat-readout-index');
      const matNameEl = document.getElementById('mat-readout-name');
      const matNotesEl = document.getElementById('mat-readout-notes');
      const matOriginEl = document.getElementById('mat-readout-origin');
      const matDensityEl = document.getElementById('mat-readout-density');
      const matFinishEl = document.getElementById('mat-readout-finish');

      function activateMaterial(matJsonStr: string | undefined) {
        if (!matJsonStr) return;
        const mat = JSON.parse(matJsonStr);

        materialPins.forEach((pin) => {
          const active = pin.dataset.materialPin === mat.id;
          pin.classList.toggle('bg-accent-hearth', active);
          pin.classList.toggle('text-canvas-primary', active);
          pin.classList.toggle('scale-110', active);
          pin.classList.toggle('bg-canvas-primary/90', !active);
          pin.classList.toggle('text-ink-primary', !active);
        });

        materialTabs.forEach((tab) => {
          const active = tab.dataset.materialTab === mat.id;
          tab.classList.toggle('bg-ink-primary', active);
          tab.classList.toggle('text-canvas-primary', active);
          tab.classList.toggle('bg-canvas-secondary/35', !active);
          tab.classList.toggle('text-ink-secondary', !active);
        });

        if (matIndexEl) matIndexEl.textContent = mat.index;
        if (matNameEl) matNameEl.textContent = mat.name;
        if (matNotesEl) matNotesEl.textContent = mat.notes;
        if (matOriginEl) matOriginEl.textContent = mat.origin;
        if (matDensityEl) matDensityEl.textContent = mat.density;
        if (matFinishEl) matFinishEl.textContent = mat.finish;
      }

      materialPins.forEach((pin) => {
        pin.addEventListener('click', () => activateMaterial(pin.dataset.materialJson));
      });
      materialTabs.forEach((tab) => {
        tab.addEventListener('click', () => activateMaterial(tab.dataset.materialJson));
      });

      // 12. Section 05: Private Residency Dossier Calculator & Archival Pass Generator
      const nightsSelectInput = document.getElementById('nights-select') as HTMLSelectElement | null;
      const tariffBreakdownEl = document.getElementById('dossier-tariff-breakdown');
      const totalPriceEl = document.getElementById('dossier-total-price');
      const commissionForm = document.getElementById('residency-commission-form') as HTMLFormElement | null;
      const confirmationCard = document.getElementById('dossier-confirmation-card');
      const confirmedCodeEl = document.getElementById('confirmed-code');
      const confirmedSummaryEl = document.getElementById('confirmed-summary');
      const downloadDossierBtn = document.getElementById('download-dossier-btn');

      let lastGeneratedDossier: Record<string, unknown> | null = null;

      function recalculateResidencyTariff() {
        if (!chamberSelectInput || !nightsSelectInput) return;
        const selectedOption = chamberSelectInput.options[chamberSelectInput.selectedIndex];
        const rate = parseInt(selectedOption.getAttribute('data-rate') || '1450', 10);
        const nights = parseInt(nightsSelectInput.value || '3', 10);
        const total = rate * nights;

        if (tariffBreakdownEl) {
          tariffBreakdownEl.textContent = `${nights} Nights × £${rate.toLocaleString()} // ${chamberSelectInput.value}`;
        }
        if (totalPriceEl) {
          totalPriceEl.textContent = `£${total.toLocaleString()}`;
        }
      }

      chamberSelectInput?.addEventListener('change', recalculateResidencyTariff);
      nightsSelectInput?.addEventListener('change', recalculateResidencyTariff);

      commissionForm?.addEventListener('submit', (e) => {
        e.preventDefault();
        const formData = new FormData(commissionForm);
        const guestName = String(formData.get('guestName') || 'Resident Guest');
        const chamber = String(formData.get('chamber') || 'The Quarry Embrasure');
        const nights = String(formData.get('nights') || '3');
        const arrivalVector = String(formData.get('arrivalVector') || 'Kingham Station');
        const hearthTimber = String(formData.get('hearthTimber') || 'Seasoned English Oak');
        const refCode = `CTS-2026-${Math.floor(100 + Math.random() * 899)}`;

        lastGeneratedDossier = {
          reference: refCode,
          sanctuary: 'COTSY // The Vale Archive (51°49\'14.2"N 001°52\'08.9"W)',
          resident_principal: guestName,
          chamber_allocated: chamber,
          solitude_duration_nights: Number(nights),
          arrival_vector: arrivalVector,
          hearth_timber_specification: hearthTimber,
          allocated_total: totalPriceEl?.textContent || '£4,350',
          timestamp_utc: new Date().toISOString(),
          motion_law_verified: 'cubic-bezier(0.16, 1, 0.3, 1)',
        };

        if (confirmedCodeEl) confirmedCodeEl.textContent = refCode;
        if (confirmedSummaryEl) {
          confirmedSummaryEl.textContent = `Dossier inscribed for ${guestName}. ${chamber} reserved for ${nights} nights (${totalPriceEl?.textContent}). Arrival via ${arrivalVector}; hearth prepared with ${hearthTimber}.`;
        }
        if (confirmationCard) {
          confirmationCard.classList.remove('hidden');
        }
      });

      downloadDossierBtn?.addEventListener('click', () => {
        if (!lastGeneratedDossier) return;
        const blob = new Blob([JSON.stringify(lastGeneratedDossier, null, 2)], {
          type: 'application/json',
        });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `${lastGeneratedDossier.reference}-residency-dossier.json`;
        a.click();
        URL.revokeObjectURL(url);
      });
    </script>
  </body>
</html>
