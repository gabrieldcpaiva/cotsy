---
const chambers = [
  {
    id: 'quarry-embrasure',
    code: 'CH. 01',
    folio: 'FOLIO 02.A // EAST QUARRY RIDGE',
    title: 'The Quarry Embrasure',
    subtitle: 'Carved into the oolitic limestone escarpment with a deep stone window seat suspended above the morning mist.',
    area: '68 m²',
    ceiling: '3.45 m',
    acoustic: '18 dBA',
    daylight: '145 lx (East Aperture)',
    tariff: '£1,450 / NIGHT',
    materials: 'Hand-dressed Guiting stone, unbleached 480gsm Kortrijk flax, smoked English elm floorboards',
    coordinates: '51°49\'15.1"N · 001°52\'04.2"W',
    image: '/images/suite-quarry.jpg',
    svgRoofY: 22,
    svgWallWidth: 16,
    svgWindowY: 42,
  },
  {
    id: 'hearth-pavilion',
    code: 'CH. 02',
    folio: 'FOLIO 02.B // SOUTH MEADOW CANTILEVER',
    title: 'The Hearth Pavilion',
    subtitle: 'Monolithic hand-troweled slaked lime fireplace anchoring a vast timber-beamed sanctuary and private rainwater basin.',
    area: '94 m²',
    ceiling: '4.20 m',
    acoustic: '19 dBA',
    daylight: '210 lx (South-West Clerestory)',
    tariff: '£1,920 / NIGHT',
    materials: 'Cotswold slaked lime putty, 17th-century reclaimed wych elm trusses, honed travertine flagstones',
    coordinates: '51°49\'13.8"N · 001°52\'09.5"W',
    image: '/images/hearth-pavilion.jpg',
    svgRoofY: 14,
    svgWallWidth: 20,
    svgWindowY: 34,
  },
  {
    id: 'basalt-bathhouse',
    code: 'CH. 03',
    folio: 'FOLIO 02.C // SUBTERRANEAN AQUIFER VAULT',
    title: 'The Basalt Bathhouse Suite',
    subtitle: 'Subterranean sleeping and thermal bathing sanctuary centered on a monolithic carved basalt vessel fed by artesian spring water.',
    area: '112 m²',
    ceiling: '3.90 m',
    acoustic: '16 dBA',
    daylight: '85 lx (Zenithal Oculus)',
    tariff: '£2,380 / NIGHT',
    materials: 'Honed dark basalt monolith, dry-stacked quarry rubble walling, raw beeswax-treated Douglas fir',
    coordinates: '51°49\'12.4"N · 001°52\'11.0"W',
    image: '/images/bathhouse-thermal.jpg',
    svgRoofY: 28,
    svgWallWidth: 26,
    svgWindowY: 18,
  },
  {
    id: 'cloister-loft',
    code: 'CH. 04',
    folio: 'FOLIO 02.D // WEST VALLEY COLONNADE',
    title: 'The Cloister Botanical Loft',
    subtitle: 'A covered stone colonnade and private herbarium study opening directly onto forty-two acres of unploughed wildflower wold.',
    area: '82 m²',
    ceiling: '3.75 m',
    acoustic: '20 dBA',
    daylight: '190 lx (Colonnade Loggia)',
    tariff: '£1,680 / NIGHT',
    materials: 'Silvered European larch colonnade, hand-forged patinated bronze hardware, wild meadow botanical archive',
    coordinates: '51°49\'16.0"N · 001°52\'12.7"W',
    image: '/images/meadow-cloister.jpg',
    svgRoofY: 18,
    svgWallWidth: 14,
    svgWindowY: 48,
  },
];
---

<section
  id="chambers"
  class="relative w-full px-5 md:px-10 py-[20vh] hairline-t"
  data-vacancy-section="chambers"
>
  <!-- Asymmetric Section Header: Col 1-5 Occupied, Col 6-12 Negative Space Void -->
  <div class="grid grid-cols-12 gap-y-12">
    <div class="col-span-12 lg:col-span-5 cotsy-reveal">
      <div class="flex items-center gap-3 mb-4">
        <span class="text-[9px] tracking-[0.26em] uppercase font-thin text-ink-muted">
          [02 // ARCHITECTURAL RESIDENCY LEDGER]
        </span>
        <span class="h-[1px] w-12 bg-ink-muted/30"></span>
        <span class="text-[9px] tracking-[0.22em] uppercase font-thin text-accent-hearth">
          SEVEN CHAMBERS TOTAL
        </span>
      </div>
      <h2
        class="font-editorial text-ink-primary"
        style="font-size: clamp(2.4rem, 5.2vw, 5.4rem); line-height: 0.93; letter-spacing: -0.028em;"
      >
        Chambers of<br />
        <span class="font-editorial-italic text-ink-secondary">proportioned solitude.</span>
      </h2>
    </div>

    <!-- Col 6-9: Uninhabited Limestone Canvas Void -->
    <div class="hidden lg:block lg:col-span-4" aria-hidden="true"></div>

    <!-- Col 10-12: Sparse Technical Metadata Note -->
    <div class="col-span-12 lg:col-span-3 flex flex-col justify-end cotsy-reveal">
      <p class="text-[12px] font-light text-ink-secondary leading-[1.9]">
        Each chamber is acoustically isolated by 620mm of dry-coursed oolitic stone and lime hemp plaster. No televisions, no synthetic lacquer, no algorithmic climate control.
      </p>
    </div>
  </div>

  <!-- Asymmetric Interactive Ledger Stage (14vh vertical breathing space) -->
  <div class="mt-[14vh] grid grid-cols-12 gap-y-12 items-start">
    <!-- Col 1-4: Sparse Typographic Chamber Index -->
    <div class="col-span-12 lg:col-span-4 flex flex-col hairline-t" role="tablist" aria-label="Architectural Chambers">
      {chambers.map((chamber, idx) => (
        <button
          type="button"
          role="tab"
          aria-selected={idx === 0 ? 'true' : 'false'}
          data-chamber-trigger={chamber.id}
          data-chamber-json={JSON.stringify(chamber)}
          class:list={[
            'chamber-tab group text-left py-7 px-4 hairline-b transition-all duration-900 ease-cotsy flex flex-col gap-2',
            idx === 0 ? 'bg-canvas-secondary/65 is-active' : 'hover:bg-canvas-secondary/30',
          ]}
        >
          <div class="flex items-center justify-between w-full">
            <span class="text-[9px] tracking-[0.24em] uppercase font-thin text-ink-muted group-hover:text-accent-hearth transition-colors duration-450 ease-cotsy">
              {chamber.code} // {chamber.area}
            </span>
            <span class="text-[9px] tracking-[0.22em] uppercase font-light text-ink-secondary">
              {chamber.tariff}
            </span>
          </div>
          <div class="flex items-baseline justify-between gap-4">
            <span class="font-editorial text-2xl md:text-3xl text-ink-primary group-hover:translate-x-2 transition-transform duration-900 ease-cotsy">
              {chamber.title}
            </span>
            <span class="text-[9px] tracking-[0.2em] uppercase font-thin text-ink-muted">
              [{chamber.acoustic}]
            </span>
          </div>
        </button>
      ))}

      <!-- Architectural Section Elevation Schematic (Nested in Col 1-4 below index) -->
      <div class="mt-10 p-5 hairline-box bg-canvas-secondary/25">
        <div class="flex items-center justify-between mb-3">
          <span class="text-[9px] tracking-[0.24em] uppercase font-thin text-ink-muted">
            LIVE LITHIC SECTION // 1:100 METRIC
          </span>
          <span id="chamber-elevation-label" class="text-[9px] tracking-[0.2em] uppercase font-light text-accent-hearth">
            CEILING 3.45M
          </span>
        </div>
        <svg viewBox="0 0 240 100" class="w-full h-24 text-ink-primary">
          <!-- Datum Horizon -->
          <line x1="10" y1="84" x2="230" y2="84" stroke="currentColor" stroke-opacity="0.25" stroke-width="0.75" />
          <!-- Stone Masonry Wall Left -->
          <rect
            id="svg-chamber-wall"
            x="32"
            y="22"
            width="16"
            height="62"
            fill="currentColor"
            fill-opacity="0.14"
            stroke="currentColor"
            stroke-width="0.8"
            class="transition-all duration-1100 ease-cotsy"
          />
          <!-- Cantilever Timber Roof -->
          <line
            id="svg-chamber-roof"
            x1="24"
            y1="22"
            x2="206"
            y2="22"
            stroke="currentColor"
            stroke-width="1.25"
            class="transition-all duration-1100 ease-cotsy"
          />
          <!-- Interior Volume -->
          <rect
            x="48"
            y="28"
            width="142"
            height="56"
            fill="none"
            stroke="currentColor"
            stroke-opacity="0.18"
            stroke-dasharray="2 2"
          />
          <!-- Daylight Aperture Vector -->
          <line
            id="svg-chamber-light"
            x1="215"
            y1="12"
            x2="95"
            y2="84"
            stroke="var(--accent-hearth)"
            stroke-width="0.9"
            stroke-dasharray="3 2"
            class="transition-all duration-1100 ease-cotsy"
          />
          <circle id="svg-chamber-hearth" cx="76" cy="78" r="3" fill="var(--accent-hearth)" />
          <text x="14" y="95" font-size="6" fill="currentColor" opacity="0.55" font-family="IBM Plex Mono">
            620MM OOLITIC WALL
          </text>
          <text x="145" y="95" font-size="6" fill="currentColor" opacity="0.55" font-family="IBM Plex Mono">
            VALLEY APERTURE →
          </text>
        </svg>
      </div>
    </div>

    <!-- Col 5-6: Uninhabited Negative Space Bay (Preserving ≥50% Canvas Vacancy) -->
    <div class="hidden lg:flex lg:col-span-2 flex-col items-center justify-center py-24" aria-hidden="true">
      <div class="h-64 w-[1px] bg-ink-muted/15 relative">
        <span class="absolute top-1/2 -translate-y-1/2 -left-12 -rotate-90 text-[8px] tracking-[0.28em] uppercase font-thin text-ink-muted/60 whitespace-nowrap">
          VOID BAY C.05–C.06
        </span>
      </div>
    </div>

    <!-- Col 7-12: Large-Format Architectural Plate & Telemetry Readout -->
    <div
      class="col-span-12 lg:col-span-6 cotsy-parallax-layer"
      data-parallax-speed="-0.09"
    >
      <div class="relative hairline-box p-3 md:p-5 bg-canvas-elevated/60">
        <div class="flex items-center justify-between mb-3 text-[9px] tracking-[0.22em] uppercase font-thin text-ink-muted">
          <span id="chamber-stage-folio">FOLIO 02.A // EAST QUARRY RIDGE</span>
          <span id="chamber-stage-coords">51°49'15.1"N · 001°52'04.2"W</span>
        </div>

        <div
          id="chamber-stage-curtain"
          class="cotsy-image-curtain is-revealed aspect-[16/10] w-full overflow-hidden"
        >
          <img
            id="chamber-stage-img"
            src="/images/suite-quarry.jpg"
            alt="The Quarry Embrasure chamber interior"
            class="w-full h-full object-cover"
          />
        </div>

        <!-- Asymmetric Technical Specification Footer Below Plate -->
        <div class="mt-6 grid grid-cols-12 gap-6 pt-5 hairline-t">
          <div class="col-span-12 md:col-span-7">
            <h3
              id="chamber-stage-title"
              class="font-editorial text-3xl text-ink-primary mb-2"
            >
              The Quarry Embrasure
            </h3>
            <p
              id="chamber-stage-subtitle"
              class="text-[12px] font-light text-ink-secondary leading-[1.9]"
            >
              Carved into the oolitic limestone escarpment with a deep stone window seat suspended above the morning mist.
            </p>
          </div>

          <div class="col-span-12 md:col-span-5 flex flex-col justify-between gap-3 hairline-l pl-0 md:pl-5">
            <div>
              <span class="block text-[8px] tracking-[0.24em] uppercase font-thin text-ink-muted">
                MATERIAL PROVENANCE
              </span>
              <p
                id="chamber-stage-materials"
                class="text-[11px] font-light text-ink-secondary leading-relaxed mt-1"
              >
                Hand-dressed Guiting stone, unbleached 480gsm Kortrijk flax, smoked English elm floorboards
              </p>
            </div>

            <div class="flex items-center justify-between pt-3 hairline-t">
              <div>
                <span class="block text-[8px] tracking-[0.24em] uppercase font-thin text-ink-muted">
                  ILLUMINANCE
                </span>
                <span id="chamber-stage-daylight" class="text-[10px] font-light text-ink-primary">
                  145 lx (East Aperture)
                </span>
              </div>
              <a
                href="#residency-dossier"
                id="chamber-stage-reserve"
                data-select-chamber="The Quarry Embrasure"
                class="px-3.5 py-1.5 hairline-box bg-ink-primary text-canvas-primary text-[9px] tracking-[0.22em] uppercase font-light hover:bg-accent-hearth transition-colors duration-450 ease-cotsy"
              >
                [COMMISSION STAY →]
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
